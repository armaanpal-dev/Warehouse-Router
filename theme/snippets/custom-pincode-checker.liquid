{%- comment -%}
  Pincode delivery checker. Two modes, picked by the pincode block's settings:
  - availability_api set: POSTs { variant_id, quantity, pincode } to the warehouse API (Task 2).
  - otherwise: resolves the pincode against the delivery_zones table below, client-side.
  Accepts: block (the pincode block), section_id
{%- endcomment -%}
<pincode-checker
  class="pc"
  data-api="{{ block.settings.availability_api | escape }}"
  data-cutoff="{{ block.settings.cutoff_hour }}"
>
  <form class="pc__form" novalidate data-pincode-form>
    <label class="pc__label" for="Pincode-{{ section_id }}">
      <span class="svg-wrapper" aria-hidden="true">{{ 'icon-truck.svg' | inline_asset_content }}</span>
      Check delivery availability
    </label>
    <div class="pc__row">
      <input
        id="Pincode-{{ section_id }}"
        class="pc__input field__input"
        type="text"
        inputmode="numeric"
        autocomplete="postal-code"
        maxlength="6"
        pattern="[1-9][0-9]{5}"
        placeholder="Enter 6-digit pincode"
        aria-describedby="PincodeResult-{{ section_id }}"
        data-pincode-input
      >
      <button type="submit" class="pc__btn button button--secondary" data-pincode-submit>Check</button>
    </div>
  </form>
  <div id="PincodeResult-{{ section_id }}" class="pc__result" role="status" aria-live="polite" data-pincode-result></div>
  <script type="application/json" data-zones>
    [
      {%- assign lines = block.settings.delivery_zones | newline_to_br | split: '<br />' -%}
      {%- assign first = true -%}
      {%- for line in lines -%}
        {%- assign parts = line | strip | split: '|' -%}
        {%- if parts.size == 3 -%}
          {%- assign range = parts[0] | strip | split: '-' -%}
          {%- unless first -%},{%- endunless -%}
          {%- assign first = false -%}
          {"from": {{ range.first | strip | plus: 0 }}, "to": {{ range.last | strip | plus: 0 }}, "warehouse": {{ parts[1] | strip | json }}, "days": {{ parts[2] | strip | plus: 0 }}}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>
</pincode-checker>
