# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# mock | token | cli
#   mock  – in-memory fixture store, no Shopify needed (default; used by the tests)
#   token – Admin API over HTTPS with an access token (production)
#   cli   – dev only: shells out to `shopify store execute` using your CLI login
SHOPIFY_MODE=mock
SHOPIFY_SHOP=another-shpyfy-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
# Leave blank to have the server fetch (and refresh) a token with the client credentials grant.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CLIENT_ID=
# The app's client secret. Used to verify webhook HMACs and app-proxy signatures.
SHOPIFY_API_SECRET=replace-me-with-a-long-random-string

# Shopify location GIDs for each warehouse. Leave blank in mock mode.
# `npm run sync-locations` looks them up by name and prints the lines to paste here.
WAREHOUSE_DEL_LOCATION_ID=
WAREHOUSE_BLR_LOCATION_ID=
WAREHOUSE_BOM_LOCATION_ID=

# Key for the /api/admin/* endpoints (send as the X-Api-Key header).
ADMIN_API_KEY=replace-me
# Comma-separated storefront origins allowed to call /api/express-availability from the browser.
CORS_ORIGINS=https://another-shpyfy-store.myshopify.com,http://127.0.0.1:9292

DATABASE_PATH=./data/app.db
# Inventory reads are cached this long (ms); on Shopify outage we serve the ledger up to STALE_MAX_MS old.
INVENTORY_CACHE_MS=10000
STALE_MAX_MS=300000
RECONCILE_INTERVAL_MS=300000
# Orders created this far back are checked for missed webhooks (on boot and every reconcile).
CATCHUP_WINDOW_MS=259200000
RATE_LIMIT_PER_MINUTE=60
